{
  "_comment": "Source registry for the ECNL Girls dashboard. Single source of truth for which TGS/AthleteOne event IDs back each season+conference. Read by ecnl-dashboard.html at startup and by archive.py. Add a season by adding a key under `seasons`, then run: python archive.py --verify --season <key>",
  "updated": "2026-08-27",
  "apiBase": "https://api.athleteone.com/api",
  "endpoints": {
    "hierarchy": "Event/get-event-schedule-or-standings/{eventId}",
    "standings": "Event/get-standings-by-div-and-flight/{divisionId}/{flightId}/{eventId}",
    "schedule": "Event/get-schedules-by-flight/{eventId}/{flightId}/0",
    "brackets": "Event/get-flight-brackets-by-flight/{eventId}/{flightId}",
    "eventDetails": "Event/get-event-details-by-eventID/{eventId}"
  },
  "refresh": {
    "_comment": "Drives `archive.py --refresh`. Only activeSeason is ever fetched; past seasons are final. everyHours documents intent - the cron in .github/workflows/refresh.yml is the real schedule, so keep them in sync.",
    "activeSeason": "2026-27",
    "matchDay": { "everyHours": 2, "lookbackDays": 2, "timezonePaddingDays": 1 },
    "sweep": { "daily": true, "atUtcHour": 6 },
    "pending": { "maxPendingAgeDays": 21 },
    "minIntervalMinutes": 90
  },

  "publicUrlTemplates": {
    "_comment": "Original public website links, preserved alongside the archived data. TGS is migrating to app.athleteone.com; change the host here in one place if public.totalglobalsports.com retires.",
    "standings": "https://public.totalglobalsports.com/public/event/{eventId}/standings/{flightId}",
    "schedules": "https://public.totalglobalsports.com/public/event/{eventId}/schedules/{flightId}",
    "eventHome": "https://public.totalglobalsports.com/public/event/{eventId}/schedules-standings"
  },
